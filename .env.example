# DreamHomes — vista frontend
# Copy to .env.local and adjust as needed.

# Canonical site URL (no trailing slash). Used for metadataBase, sitemap, robots, JSON-LD.
# Production: https://www.dreamhomes.today
NEXT_PUBLIC_SITE_URL=https://www.dreamhomes.today

# Browser uses `app/api/[...path]` rewrite to Haven; set to production API in deploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Self-hosted Docker: build with `pnpm build` (Next `output: "standalone"`), then run
# `node .next/standalone/server.js` per Next.js docs — see next.config.mjs.
