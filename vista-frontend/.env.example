# --- haven (Java backend) ---------------------------------------------------
# Used server-side only (Server Components, Route Handlers, Server Actions).
# Never expose the bare backend URL to the browser — calls go through Next.js
# proxy routes in app/api/* so we can keep the JWT in an httpOnly cookie.
HAVEN_API_URL=http://localhost:8080

# Cookie name for the JWT issued by haven. Override if you change it.
HAVEN_AUTH_COOKIE=dh_session
